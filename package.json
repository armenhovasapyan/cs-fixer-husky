{
  "devDependencies": {
    "husky": "^4.2.5",
    "lint-staged": "^10.1.3",
    "prettier": "^2.0.4"
  },
  "lint-staged": {
    "*.php": "php ./vendor/bin/php-cs-fixer fix --config=.php_cs --verbose --dry-run --using-cache=no --path-mode=intersection --diff -- $(git diff --name-only --diff-filter=ACMRTUXB HEAD~..HEAD)"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
